<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema LightWeather en modo oscuro -->
    <style name="Theme.LightWeather" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Colores globales -->
        <item name="colorPrimary">@color/lw_blue_dark</item>
        <item name="colorPrimaryVariant">@color/lw_blue_dark</item>
        <item name="colorSecondary">@color/lw_blue_light</item>

        <!-- Texto sobre primary -->
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Fondo general -->
        <item name="android:windowBackground">@color/lw_background</item>

        <!-- Barras del sistema -->
        <item name="android:statusBarColor">@color/lw_blue_dark</item>
        <item name="android:navigationBarColor">@color/lw_background</item>

        <!-- Textos primarios y secundarios -->
        <item name="android:textColorPrimary">@color/lw_blue_light</item>
        <item name="android:textColorSecondary">@color/lw_blue_light</item>

        <!-- Botones Material -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>

        <!-- Formas redondeadas -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MaterialComponents.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MaterialComponents.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MaterialComponents.LargeComponent</item>

    </style>

</resources>
