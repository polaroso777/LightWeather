<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Encabezado reutilizable -->
    <include
        android:id="@+id/includeCurrentHeaderWeek"
        layout="@layout/view_current_header" />

    <!-- Lista semanal -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWeek"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="8dp" />

    <!-- Resumen / recomendaciones semanales globales -->
    <LinearLayout
        android:id="@+id/weekSummaryContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/tvWeekSummaryRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En la semana: --°–--°"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvWeekSummaryRain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resumen de lluvia semanal"
            android:textSize="14sp"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/tvWeekSummaryAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consejo general para la semana"
            android:textSize="14sp"
            android:paddingTop="2dp" />
    </LinearLayout>

</LinearLayout>
