<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <!-- Título: ubicación + mini resumen -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ubicación — --° / Lluvia --%"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/lw_blue_dark"
        android:paddingBottom="8dp" />

    <!-- Bloque principal -->
    <LinearLayout
        android:id="@+id/currentWeatherContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Icono principal -->
        <ImageView
            android:id="@+id/ivMainIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/wi_thermometer"
            android:contentDescription="Clima actual" />

        <!-- Temperatura principal -->
        <TextView
            android:id="@+id/tvTempMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--°C"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="@color/lw_blue_dark"
            android:layout_marginEnd="16dp" />

        <!-- Info secundaria -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/wi_thermometer_exterior"/>

                <TextView
                    android:id="@+id/tvFeelsLike"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Sensación: --°C"
                    android:textSize="14sp"
                    android:textColor="@color/lw_blue_light"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/wi_windy"/>

                <TextView
                    android:id="@+id/tvWindSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Viento: -- km/h"
                    android:textSize="14sp"
                    android:textColor="@color/lw_blue_light"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
