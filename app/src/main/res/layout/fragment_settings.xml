        <!-- Sección: Permisos -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/lw_white">

            <LinearLayout
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvPermissionsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permisos"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/lw_blue_dark"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/tvLocationPermissionStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ubicación: estado desconocido"
                        android:textSize="14sp"
                        android:textColor="@color/lw_blue_light"/>

                    <Button
                        android:id="@+id/btnManagePermissions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Administrar"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sección: Versión y restablecer -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/lw_white">

            <LinearLayout
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnResetSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Restablecer ajustes"/>

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="LightWeather • Versión 1.0.0"
                    android:textSize="13sp"
                    android:textColor="@color/lw_blue_light"/>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
