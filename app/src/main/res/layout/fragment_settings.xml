<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp"
    android:background="@color/lw_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título general -->
        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajustes"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/lw_blue_dark"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Sección: Ubicación favorita -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/lw_white">

            <LinearLayout
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvLocationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación favorita"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/lw_blue_dark" />

                <TextView
                    android:id="@+id/tvLocationSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Elige una ciudad manualmente o usa tu ubicación actual."
                    android:textSize="14sp"
                    android:textColor="@color/lw_blue_light" />

                <EditText
                    android:id="@+id/etFavoriteLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Ciudad, país"
                    android:background="@android:drawable/editbox_background_normal"
                    android:padding="10dp"
                    android:textColor="@color/lw_blue_dark"
                    android:textColorHint="@color/lw_blue_light"
                    android:singleLine="true"/>

                <Button
                    android:id="@+id/btnSaveFavoriteLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Guardar ciudad" />

                <Button
                    android:id="@+id/btnUseCurrentLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Usar ubicación actual" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sección: Ciudades guardadas -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSavedLocations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/lw_white">

            <LinearLayout
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvSavedLocationsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ciudades guardadas"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/lw_blue_dark"/>

                <TextView
                    android:id="@+id/tvSavedLocationsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Selecciona una ciudad para usarla o elimínala."
                    android:textSize="14sp"
                    android:textColor="@color/lw_blue_light"/>

                <TextView
                    android:id="@+id/tvEmptyLocations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Aún no tienes ciudades guardadas."
                    android:textSize="14sp"
                    android:textColor="@color/lw_blue_light"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSavedLocations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

